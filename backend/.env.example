# ==========================================================
# AI Executive Assistant - environment template
# Copy to backend/.env and fill in the values.
# ==========================================================

# ----------------------------------------------------------
# 1. REQUIRED: Gemini API key
#    https://aistudio.google.com/ -> "Get API key"
# ----------------------------------------------------------
GEMINI_API_KEY=PASTE_YOUR_GEMINI_API_KEY

# Model selection (optional). If the primary is overloaded (503), the backend
# retries and then walks the fallback list in order.
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-flash-latest
# GEMINI_ATTEMPTS=2
# GEMINI_REQUEST_TIMEOUT_MS=30000
# GEMINI_MAX_SECONDS=90

# ----------------------------------------------------------
# 2. EMAIL (real sending): Gmail SMTP with an App Password
#    Google Account -> Security -> 2-Step Verification ON
#    -> App passwords -> create one (16 chars) -> paste below.
#    SMTP_EMAIL must be the same account that owns the App Password.
#    Leave the password as a placeholder to run in simulation mode.
# ----------------------------------------------------------
SMTP_EMAIL=you@gmail.com
SMTP_APP_PASSWORD=your_16_char_app_password
# Where the proactive morning briefing is delivered (comma separated allowed).
EXECUTIVE_EMAIL=you@gmail.com
# BRIEFING_RECIPIENTS=you@gmail.com,assistant@yourcompany.com

# ----------------------------------------------------------
# 3. CALENDAR (real sync)
#    This project uses a SERVICE ACCOUNT by default.
#    - Save the service-account JSON key as backend/service_account.json
#    - Share the target calendar with the service-account email
#      ("Make changes to events")
#    - Verify any time: python backend/google_auth.py
#    Service accounts cannot send guest invite emails (Google limitation).
CALENDAR_BACKEND=auto          # auto | service_account | oauth
GOOGLE_CALENDAR_ID=you@gmail.com
SERVICE_ACCOUNT_FILE=service_account.json

#    OPTION: OAuth - only needed if you want real guest invitations.
#    Save the OAuth "Desktop app" client JSON as backend/credentials.json,
#    then run once:  python backend/google_oauth.py   (creates token.json)
#    With CALENDAR_BACKEND=auto, OAuth is preferred once token.json exists.
# GOOGLE_OAUTH_CLIENT_SECRET_FILE=credentials.json
# GOOGLE_OAUTH_TOKEN_FILE=token.json

# 4. SCHEDULING / TIMEZONE
#    Events are written to Google Calendar in this IANA timezone, and the
#    built-in scheduler fires at BRIEFING_HOUR:BRIEFING_MINUTE local time.
# ----------------------------------------------------------
APP_TIMEZONE=Africa/Addis_Ababa
BRIEFING_HOUR=8
BRIEFING_MINUTE=0

# ----------------------------------------------------------
# 5. SECURITY (recommended before exposing the API beyond localhost)
#    When set, POST/DELETE calls must send "X-API-Key: <token>".
#    The Next.js UI reads NEXT_PUBLIC_API_KEY (frontend/.env.local).
# ----------------------------------------------------------
# API_AUTH_TOKEN=change-me-to-a-long-random-string
# ALLOWED_ORIGINS=http://localhost:3000
